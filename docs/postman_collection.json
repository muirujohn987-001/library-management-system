{
  "info": {
    "name": "Library Management System API",
    "description": "Postman collection for testing the Library Management System backend. Includes authentication, genre management, book management, search, filtering and pagination.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "email",
      "value": "postman.tester@example.com"
    },
    {
      "key": "password",
      "value": "TestPass123!"
    },
    {
      "key": "genreId",
      "value": ""
    },
    {
      "key": "bookId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register User",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('email', 'postman.' + Date.now() + '@example.com');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Tester\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Login User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login successful', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const response = pm.response.json();",
                  "if (response.access_token) {",
                  "    pm.collectionVariables.set('token', response.access_token);",
                  "    console.log('JWT token saved successfully.');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/auth/login"
          }
        }
      ]
    },
    {
      "name": "Genres",
      "item": [
        {
          "name": "Create Genre",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('genreId', response.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Test Genre\",\n  \"description\": \"A genre created while testing the LMS API.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/genres"
          }
        },
        {
          "name": "Get All Genres",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/genres"
          }
        },
        {
          "name": "Get Genre By ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/genres/{{genreId}}"
          }
        },
        {
          "name": "Update Genre",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Postman Genre\",\n  \"description\": \"Updated genre description.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/genres/{{genreId}}"
          }
        },
        {
          "name": "Delete Genre",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/genres/{{genreId}}"
          }
        }
      ]
    },
    {
      "name": "Books",
      "item": [
        {
          "name": "Get All Books",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/books"
          }
        },
        {
          "name": "Get Books By Genre",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/books?genreId={{genreId}}"
          }
        },
        {
          "name": "Search Books",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/books?search=the"
          }
        },
        {
          "name": "Paginate Books",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/books?page=1&limit=5"
          }
        },
        {
          "name": "Get Book By ID",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/books/{{bookId}}"
          }
        },
        {
          "name": "Create Book",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "    pm.collectionVariables.set('bookId', response.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman Test Book\",\n  \"author\": \"Test Author\",\n  \"isbn\": \"9781234567890\",\n  \"totalCopies\": 2,\n  \"genreId\": \"{{genreId}}\",\n  \"publishedYear\": 2024\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/books"
          }
        },
        {
          "name": "Update Book",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated Postman Test Book\",\n  \"totalCopies\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/books/{{bookId}}"
          }
        },
        {
          "name": "Delete Book",
          "request": {
            "method": "DELETE",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "url": "{{baseUrl}}/books/{{bookId}}"
          }
        }
      ]
    }
  ]
}
